# Shared by full-board and managed examples. Headers and archives are one unit.
if(NOT EXISTS "${MOTO_SDK_DIR}/BUILD_INFO.json" OR NOT EXISTS "${MOTO_SDK_DIR}/components/moto_prebuilt/CMakeLists.txt")
    message(FATAL_ERROR "Import the matching binary SDK first: python3 tools/import_sdk.py /path/to/package.zip")
endif()
file(READ "${MOTO_SDK_DIR}/BUILD_INFO.json" moto_sdk_info)
string(JSON moto_sdk_version GET "${moto_sdk_info}" sdk_version)
string(JSON moto_sdk_revision GET "${moto_sdk_info}" package_revision)
string(JSON moto_sdk_abi GET "${moto_sdk_info}" freertos_abi)
if(NOT moto_sdk_version MATCHES "^1\\." OR moto_sdk_version VERSION_LESS "1.0.0" OR moto_sdk_revision LESS 27 OR NOT moto_sdk_abi EQUAL 8)
    message(FATAL_ERROR "Requires hardware SDK 1.x / revision 27 or newer / ABI 8; replace the complete package.")
endif()
foreach(feature capability_negotiation route_vector_version seat_control mirror_resume managed_mirror managed_audio)
    string(JSON value GET "${moto_sdk_info}" "${feature}")
    if(NOT value EQUAL 1)
        message(FATAL_ERROR "SDK package lacks required feature: ${feature}; import the complete matching package.")
    endif()
endforeach()
